rules_version = '2';

// Mirrors the Firestore model: every object belongs to exactly one user, and
// only that user can touch it.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Scratch space for the plant-identification upload.
    match /identify_temp/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid);
    }

    // A plant's growth-photo timeline.
    //
    // The recursive wildcard matters: deleting a plant calls listAll() on the
    // *folder* `plant_photos/{uid}/{plantId}`, and Storage authorises a list
    // against the prefix being listed. The previous rule only matched full
    // object paths, so the list was denied and the cleanup silently failed -
    // leaving orphaned image files in the bucket (and on the bill) for every
    // plant ever deleted.
    match /plant_photos/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid);
    }

    // Profile pictures are stored flat as `{uid}.jpg`, so ownership is the
    // filename rather than a path segment.
    match /profile_photos/{fileName} {
      allow read, write: if request.auth != null
                         && fileName == request.auth.uid + '.jpg';
    }
  }
}

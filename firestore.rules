rules_version = '2';

// Thicket's data is strictly per-user. Every document the app reads or writes
// lives under `users/{uid}/...`, so ownership is the whole access model:
//
//   users/{uid}/gardens/{gardenId}
//   users/{uid}/plants/{plantId}
//   users/{uid}/plants/{plantId}/photos/{photoId}
//   users/{uid}/plants/{plantId}/journal/{entryId}
//   users/{uid}/care_log/{logId}
//   users/{uid}/propagations/{propId}
//   users/{uid}/propagations/{propId}/photos/{photoId}
//   users/{uid}/wishlist/{itemId}
//
// Anything outside that subtree is denied, because nothing in the app reads
// or writes anything else. Cloud Functions use the Admin SDK, which bypasses
// these rules entirely, so tightening here cannot break them.
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous sign-in is a real, permanent identity in Firebase Auth - the
    // app signs every install in anonymously and later *links* an
    // email/password to that same uid. So `request.auth != null` deliberately
    // includes anonymous users; excluding them would lock out every user who
    // has not created an account yet, which is most of them.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Recursive: plants, their photo timeline and journal, the care log,
      // propagations and their photos, and the wishlist.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deliberately no catch-all allow. Any path not matched above is denied,
    // which is what should happen to a collection this app does not use.
  }
}
